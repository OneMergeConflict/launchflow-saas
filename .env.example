# ==============================================================================
# LaunchFlow Environment Variables Configuration
# ==============================================================================
# NOTE: Only public/publishable anon keys should be used on the frontend!
# NEVER place your Supabase service_role key here.
# ==============================================================================

# Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
